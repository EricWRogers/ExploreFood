[sub_resource type="Resource" id="Resource_b44jk"]
resource_name = "Fail Tutorial"
script = ExtResource("15_ehwar")
dialogue_lines = Array[String](["Oh... This is repulsive.", "No, it's fine! We can try again.", "I put some new ingredients out for you!", "Don't be afraid to try something new. Good luck!"])
