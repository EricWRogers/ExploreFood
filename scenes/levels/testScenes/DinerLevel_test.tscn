resource_name = "Pass Tutorial"
script = ExtResource("15_ehwar")
dialogue_lines = Array[String](["Oh, yes, wonderful! ", "I think you're ready to go out there and collect me some REAL ingredients.", "Hop through the wormhole behind the door, and grab some new stuff.", "Next up, I want a MEAT PIE.", "See ya!"])
