[sub_resource type="Shader" id="Shader_7ygjy"]
code = "shader_type spatial;
//render_mode unshaded;

uniform vec3 color_one : source_color;
uniform vec3 color_two : source_color;

uniform float angle = 20.0;
uniform float line_count = 20.0;
uniform float speed = 10.0;
uniform float blur : hint_range(0.0, 2.0, 0);
uniform vec2 overlay_uv_scale = vec2(1.0, 1.0);

uniform sampler2D mesh_texture : source_color;
uniform float transparency : hint_range(0.0, 1.0) = 1.0; // 1 = full effect, 0 = full texture

// --- new ---
uniform sampler2D overlay_texture : source_color;
uniform float blend : hint_range(0.0, 1.0) = 0.0;  // 0 = first result, 1 = overlay only
uniform float burnt : hint_range(0.0, 1.0) = 0.0;  // 0 = no burn, 1 = fully tinted by burnt_color
uniform vec3 burnt_color : source_color = vec3(0.25, 0.15, 0.1);

vec2 rotate(vec2 uv, float rotation_angle) {
    float radians_angle = radians(rotation_angle);
    float cos_angle = cos(radians_angle);
    float sin_angle = sin(radians_angle);
    mat2 rotation_matrix = mat2(vec2(cos_angle, -sin_angle), vec2(sin_angle, cos_angle));
    return uv * rotation_matrix;
}

float stripe(vec2 uv) {
    return cos(uv.x * 0.0 - TIME * speed + uv.y * -line_count / 2.0);
}

void fragment() {
    vec2 uv = UV;
    vec2 rotated_uv = rotate(uv, angle);
    float g = stripe(rotated_uv);
    vec3 stripe_col = mix(color_one, color_two, smoothstep(0.0, blur, g));

    vec3 tex_col = texture(mesh_texture, uv).rgb;

    // first result (your original output)
    vec3 first_col = mix(tex_col, stripe_col, transparency);

    // second texture, darkened by the burn color
    vec3 overlay_col = texture(overlay_texture, uv * overlay_uv_scale).rgb;
    vec3 burnt_col = overlay_col * burnt_color;          // multiply = darken/tint
    vec3 second_col = mix(overlay_col, burnt_col, burnt);

    ALBEDO = mix(first_col, second_col, blend);
}
"

