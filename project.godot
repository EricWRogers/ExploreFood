; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ExploreFood"
run/main_scene="uid://bhtjqqne537hh"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=160
config/icon="res://icon.svg"

[autoload]

Manager="*uid://bjr5b12cf4cru"
DialogueManager="*uid://bl2apitv64di7"
PauseMenu="*uid://cxpyqdm2553yb"
CyclopsAutoload="*uid://4siqre3jhe80"
ForkCollectableVisual="*uid://dv8efstm83wou"
InputManager="*uid://bxpef1g6bexd8"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[editor_plugins]

enabled=PackedStringArray("res://addons/MarchingSquaresTerrain/plugin.cfg", "res://addons/cyclops_level_builder/plugin.cfg", "res://addons/deformablemesh/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "orange",
"res://assets/": "red",
"res://data/": "teal",
"res://fp_scenes/": "yellow",
"res://scenes/": "blue",
"res://scripts/": "green"
}

[global_group]

Player="for the player"
Terrain=""
SandwichPiece=""
Ingredient=""
Viewer=""

