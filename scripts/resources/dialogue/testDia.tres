resource_name = "tutorial"
script = ExtResource("1_e65l5")
dialogue_lines = Array[String](["Welcome to your new job!", "You've received the highest honor in the galaxy...", "being my personal chef!", "Let's get you acquainted with the kitchen first.", "Behind you are some ingredients. Make me something yummy with them!", "You have an oven for baking, and a cutting board for slicing. Good luck!"])
