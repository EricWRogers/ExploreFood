[resource]
script = ExtResource("1_e65l5")
dialogue_lines = Array[String](["Hi.", "Im sooo big and hungry. Can you get me a Meat Pie?", "If you don't know how to make one try pressing [TAB]", "And heres a place you can get the ingredients.", "You can sell food and ingredients over there but don't take too long on my meat pie!", "Once you make it place it on that table. Begone! Hurry up!"])
QuestItem = "Meat_Pies"
